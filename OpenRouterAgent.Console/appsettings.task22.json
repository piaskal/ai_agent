{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "OpenRouterAgent.ConsoleApp.OpenRouter.OpenRouterClient": "Information",
        "OpenRouterAgent.ConsoleApp.Agent.Tools.Phonecall": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "restrictedToMinimumLevel": "Information" }
      }
    ]
  },
  "OpenRouter": {
    "Provider": "openrouter",
    "OpenRouterBaseUrl": "https://openrouter.ai/",
    "LlmRouterBaseUrl": "https://llmrouter.gft.com/openai/v1/",
    "BaseUrl": "",
    "ApiKey": "",
    "Model": "google/gemini-2.5-flash",
    "ToolModel": "google/gemini-2.5-flash",
    "SystemPrompt": "Run the phonecall pipeline. Call phonecall_solve once and report the hub flag. Do not invent extra dialogue.",
    "MaxTokens": 4096,
    "MaxToolRounds": 3,
    "AppName": "OpenRouterAgent.Console",
    "AppUrl": ""
  },
  "LlmRouter": {
    "ApiKey": ""
  },
  "AgentTools": {
    "EnableTools": true,
    "EnabledTools": ["phonecall_solve"],
    "TaskVerifyApiTaskName": "phonecall",
    "DisabledTools": []
  }
}
