{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "OpenRouterAgent.ConsoleApp.OpenRouter.OpenRouterClient": "Information",
        "OpenRouterAgent.ConsoleApp.Agent.Tools.Radiomonitoring": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "restrictedToMinimumLevel": "Information" }
      }
    ]
  },
  "OpenRouter": {
    "Provider": "openrouter",
    "OpenRouterBaseUrl": "https://openrouter.ai/",
    "LlmRouterBaseUrl": "https://llmrouter.gft.com/openai/v1/",
    "BaseUrl": "",
    "ApiKey": "",
    "Model": "openai/gpt-4.1-mini",
    "ToolModel": "openai/gpt-4o-mini",
    "SystemPrompt": "Run the radiomonitoring pipeline. Call radiomonitoring_solve once and report the hub response. Do not request raw attachments.",
    "MaxTokens": 2048,
    "MaxToolRounds": 4,
    "AppName": "OpenRouterAgent.Console",
    "AppUrl": ""
  },
  "LlmRouter": {
    "ApiKey": ""
  },
  "AgentTools": {
    "EnableTools": true,
    "EnabledTools": ["radiomonitoring_solve"],
    "TaskVerifyApiTaskName": "radiomonitoring",
    "DisabledTools": []
  }
}
