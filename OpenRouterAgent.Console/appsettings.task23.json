{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "OpenRouterAgent.ConsoleApp.OpenRouter.OpenRouterClient": "Information",
        "OpenRouterAgent.ConsoleApp.Agent.Tools.Shellaccess": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "restrictedToMinimumLevel": "Information" }
      }
    ]
  },
  "OpenRouter": {
    "Provider": "openrouter",
    "OpenRouterBaseUrl": "https://openrouter.ai/",
    "LlmRouterBaseUrl": "https://llmrouter.gft.com/openai/v1/",
    "BaseUrl": "",
    "ApiKey": "",
    "Model": "google/gemini-2.5-flash",
    "ToolModel": "google/gemini-2.5-flash",
    "SystemPrompt": "Solve the shellaccess task. Call shellaccess_solve once and report the hub flag. Do not invent the date, city, or coordinates.",
    "MaxTokens": 2048,
    "MaxToolRounds": 3,
    "AppName": "OpenRouterAgent.Console",
    "AppUrl": ""
  },
  "LlmRouter": {
    "ApiKey": ""
  },
  "AgentTools": {
    "EnableTools": true,
    "EnabledTools": ["shellaccess_solve"],
    "TaskVerifyApiTaskName": "shellaccess",
    "DisabledTools": []
  }
}
